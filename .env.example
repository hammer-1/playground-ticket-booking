# ─────────────────────────────────────────────────────────────────────────────
# Single env file for the whole project (backend + frontend + db).
# Copy to .env:   cp .env.example .env
# Docker Compose reads this automatically; the backend and frontend containers
# receive these values. Hostnames below (mysql, redis) are Docker service names.
# ─────────────────────────────────────────────────────────────────────────────

# ── MySQL (used by the `mysql` service) ──────────────────────────────────────
MYSQL_DATABASE=pitch_booking
MYSQL_USER=pitch
MYSQL_PASSWORD=pitch
MYSQL_ROOT_PASSWORD=root

# ── Backend ──────────────────────────────────────────────────────────────────
PORT=4000
CORS_ORIGIN=http://localhost:5200

# Prisma connection string. Inside Docker the host is the `mysql` service.
# (For running the backend directly on your host instead, use host 127.0.0.1:3306.)
DATABASE_URL=mysql://pitch:pitch@mysql:3306/pitch_booking

# Redis. Inside Docker the host is the `redis` service.
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Booking
RESERVATION_TTL_SECONDS=120

# ── Frontend (baked into the static bundle at build time by Vite) ─────────────
# These are the URLs the BROWSER uses, so they point at the published host ports.
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
