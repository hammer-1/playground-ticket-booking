# Host-development overrides for running the backend directly on your machine.
# Copy to backend/.env:  cp backend/.env.example backend/.env
#
# This file is loaded BEFORE the root .env (dotenv never overrides an already-set var),
# so these win for host runs. It only overrides the two values that differ: the root
# .env points DATABASE_URL/REDIS_URL at the Docker service names (mysql/redis), which
# don't resolve from the host — so here they point at localhost. Everything else
# (JWT_SECRET, CORS_ORIGIN, ports, TTL …) still comes from the root .env.
DATABASE_URL="mysql://pitch:pitch@127.0.0.1:3306/pitch_booking"
REDIS_URL="redis://127.0.0.1:6379"
